@model UserManagementPoC.Shared.Models.PagedResponse<UserManagementAdmin.Models.Entities.AccessGroup>
@{
    ViewData["Title"] = "Access groups";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Access groups</h1>
    <a asp-action="Create" class="btn btn-primary">New group</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Description</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Items)
                {
                    <tr>
                        <td>@g.Name</td>
                        <td class="text-muted">@g.Description</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Manage</a>
                            <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline" onsubmit="return confirm('Delete group @g.Name?')">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No access groups found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_Pagination", new UserManagementAdmin.Models.ViewModels.PaginationViewModel
{
    Page = Model.Page,
    TotalPages = Model.TotalPages,
    Action = "Index"
})