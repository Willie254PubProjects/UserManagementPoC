@model UserManagementAdmin.Models.Requests.UpdateOrganizationUnitRequest
@using UserManagementAdmin.Models.Entities
@{
    ViewData["Title"] = "Edit organization unit";
    var id = Context.Request.RouteValues["id"]?.ToString();
}
<h1>Edit organization unit</h1>
<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnitCode" class="form-label"></label>
                    <input asp-for="UnitCode" class="form-control" />
                    <span asp-validation-for="UnitCode" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CountryCode" class="form-label"></label>
                    <input asp-for="CountryCode" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TypeId" class="form-label">Type</label>
                    <select asp-for="TypeId" asp-items="@((IEnumerable<SelectListItem>)ViewData["Types"])" class="form-select">
                        <option value="">-- select --</option>
                    </select>
                    <span asp-validation-for="TypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ParentId" class="form-label">Parent</label>
                    <select asp-for="ParentId" asp-items="@((IEnumerable<SelectListItem>)ViewData["Parents"])" class="form-select">
                        <option value="">-- none --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="0">Active</option>
                        <option value="1">Inactive</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>