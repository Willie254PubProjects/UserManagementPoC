@model System.Collections.Generic.IEnumerable<UserManagementAdmin.Models.Entities.OrganizationUnit>
@{
    ViewData["Title"] = "Organization units";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Organization units</h1>
    <div class="d-flex gap-2">
        <a asp-action="Types" class="btn btn-sm btn-outline-secondary">Unit types</a>
        <a asp-action="Create" class="btn btn-primary">New unit</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Code</th><th>Type</th><th>Country</th><th>Parent</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Name</td>
                        <td><code>@u.UnitCode</code></td>
                        <td>@(u.Type?.Name)</td>
                        <td>@u.CountryCode</td>
                        <td class="small">@(u.Parent?.Name)</td>
                        <td><span class="badge @(u.Status == OrganizationUnitStatus.Active ? "text-bg-success" : "text-bg-secondary")">@u.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@u.Id" asp-route-name="@u.Name" method="post" class="d-inline" onsubmit="return confirm('Delete unit @u.Name?')">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No organization units found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>