<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - User Management Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-white">User Mgmt Admin</a>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="UsersAdmin" asp-action="Index">Users</a>
                <a class="nav-link" asp-controller="RolesAdmin" asp-action="Index">Roles</a>
                <a class="nav-link" asp-controller="PermissionsAdmin" asp-action="Index">Permissions</a>
                <a class="nav-link" asp-controller="OrganizationUnitsAdmin" asp-action="Index">Org Units</a>
                <a class="nav-link" asp-controller="AccessGroupsAdmin" asp-action="Index">Access Groups</a>
            </nav>
        </aside>
        <div class="content">
            <header class="topbar">
                <span class="small text-muted">@ViewData["Title"]</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="small text-muted">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @(User.FindFirst("display_name")?.Value ?? User.Identity.Name)
                        }
                        else
                        {
                            <text>Not signed in</text>
                        }
                    </span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Sso" asp-action="Logout">Sign out</a>
                    }
                </div>
            </header>
            <main class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>